    "dev:web": "flutter run -d chrome",
    "build:apk": "flutter build apk --release",
    "build:appbundle": "flutter build appbundle --release",
    "lint": "flutter analyze",
    "format": "dart format lib/"
  },
  "keywords": [
    "flutter",
    "dart",
    "android",
    "mobile",
    "productivity",
    "cloudflare-d1"
  ],
