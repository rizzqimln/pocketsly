{
  "name": "pocketsly-mobile",
  "version": "1.0.0",
  "description": "Flutter mobile application for Pocketsly with 24/7 Cloudflare Edge API integration",
  "scripts": {
    "dev": "flutter run",
    "dev:android": "flutter run -d android",
