# Netlify-native backend: every /api/* request is served by the Python
# function in netlify/functions/api.py — no separate backend host needed.
# Keep this ABOVE the /* SPA fallback — Netlify matches rules in order.
/api/*  /.netlify/functions/api  200

# Alternative: proxy to an external backend host (HF Spaces / Render) instead.
# Uncomment this and delete the function line above — order still matters:
# /api/*  https://<your-backend>/api/:splat  200

# SPA fallback: every unknown path serves the app shell (index.html).
/*    /index.html   200
