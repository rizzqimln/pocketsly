# Cloudflare Pages headers (the Cloudflare equivalent of netlify.toml).
# Versioned assets (?v= in index.html/sw.js) are safe to cache immutably.
/css/*
  Cache-Control: public, max-age=31536000, immutable

/js/*
  Cache-Control: public, max-age=31536000, immutable

/vendor/*
  Cache-Control: public, max-age=31536000, immutable

/img/*
  Cache-Control: public, max-age=31536000, immutable
